# ── GOOGLE CLOUD VISION API (OCR for receipts + screenshot analysis)
EXPO_PUBLIC_GOOGLE_VISION_API_KEY=

# ── GOOGLE SPEECH-TO-TEXT (voice input for Hey Monager)
EXPO_PUBLIC_GOOGLE_STT_API_KEY=

# ── GOOGLE TEXT-TO-SPEECH (Monager voice responses)
EXPO_PUBLIC_GOOGLE_TTS_API_KEY=

# ── GROQ API (LLM for analysis — FREE, fast, no Anthropic needed)
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GROQ_MODEL=llama-3.3-70b-versatile

# ── MONAGER BACKEND (your own Express/FastAPI backend)
# Already managed via EXPO_PUBLIC_API_URL above
